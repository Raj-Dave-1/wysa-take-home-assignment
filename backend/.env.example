NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL=postgres://wysa:wysa@localhost:5433/wysa

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_me_in_prod_super_secret_random
JWT_EXPIRES_IN=7d
JWT_ISSUER=wysa-api
JWT_AUDIENCE=wysa-clients

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Hold TTL (seconds)
HOLD_TTL_SECONDS=60

# Recurring materialization
RECURRING_HORIZON_DAYS=90

# Timezone shared by all users (assignment assumption)
APP_TIMEZONE=Asia/Kolkata

# Max range for a single availability query
AVAILABILITY_MAX_DAYS=30

# --- Hardening (Phase 7) ---
# Number of reverse-proxy hops in front of Node (Render/Vercel/Nginx = 1).
# Needed for correct client IP resolution → rate limiting.
TRUST_PROXY=1

# Rate limits (per 60s window)
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_BOOKING_PER_MIN=30

# Optional. If set (>= 16 chars), required as X-Admin-Token header on
# maintenance endpoints like POST /series/extend. Leave empty for local dev.
# ADMIN_TOKEN=
